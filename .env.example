# Chart Renderer standalone service configuration.
# Copy this file to .env before running the service locally.

# HTTP bind host inside the local process/container.
CHART_RENDERER_HOST=0.0.0.0

# HTTP bind port. The standalone docker-compose.yml publishes the same port.
CHART_RENDERER_PORT=8787

# Maximum JSON request body size for POST /render.
CHART_RENDERER_MAX_BODY_BYTES=1000000
